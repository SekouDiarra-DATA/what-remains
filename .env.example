# Exa (recherche pour enrichir le guide de résiliation, hors ligne uniquement)
EXA_API_KEY=

# Vitesse des appels de synthèse (secondes entre chaque service) — réduire si votre
# fournisseur a un quota confortable, augmenter si vous retombez sur des rate limits
SYNTH_CALL_DELAY_SECONDS=2

# Option 1 (par défaut) : OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Option 2 : OpenRouter (sponsor du hackathon — utilisé en production sur ce
# projet ; avec crédits, un modèle payant type openai/gpt-4o-mini fonctionne
# mieux qu'un modèle ":free" pour l'extraction JSON structurée)
# OPENAI_API_KEY=sk-or-v1-votre-clé
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Option 3 : Google Gemini (gratuit, sans carte, mais quota très limité :
# 5 requêtes/minute et 20/jour sur le free tier — insuffisant pour un usage
# répété). Vérifiez le nom du modèle actuel sur ai.google.dev avant usage :
# "gemini-2.0-flash" a été déprécié en cours de projet.
# OPENAI_API_KEY=votre-clé-google-ai-studio
# OPENAI_MODEL=gemini-3.6-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
